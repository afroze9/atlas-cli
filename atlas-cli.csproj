<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AtlasCli</RootNamespace>
    <AssemblyName>atlas-cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlas-cli</ToolCommandName>
    <PackageId>atlas-cli-tool</PackageId>
    <Version>1.10.0</Version>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Afroze Amjad</Authors>
    <Description>A .NET global tool for interacting with Jira and Confluence Cloud — manage work items, projects, sprints, spaces, and pages from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/afroze9/atlas-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/afroze9/atlas-cli</RepositoryUrl>
    <PackageTags>cli;jira;confluence;atlassian;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
  </ItemGroup>

</Project>
